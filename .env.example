# Copy to ".env" and fill in. ".env" is git-ignored: never commit real secrets.
# Used by docker compose (variable substitution) and, for local runs, read by the app itself.
# Plain KEY=value lines, no quotes.

# ---- required ----
# PostgreSQL password (also the password of the compose database)
DB_PASSWORD=change-me
# Signing key for access tokens, at least 64 characters. Generate: openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64-and-make-it-long-enough

# ---- database (defaults shown) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paraspa_db
DB_USER=postgres

# ---- optional ----
# Access token lifetime (ms) and refresh token lifetime (days)
#JWT_ACCESS_EXPIRATION_MS=900000
#JWT_REFRESH_EXPIRATION_DAYS=30
# Browser origins allowed to call the API, comma separated
#CORS_ALLOWED_ORIGINS=http://localhost:3000
# "native" when behind a reverse proxy that sends X-Forwarded-For (so rate limits see the real client IP)
#FORWARD_HEADERS_STRATEGY=none
# Rate limits: capacity per period (login/register/refresh per IP, message per user)
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_LOGIN_CAPACITY=10
#RATE_LIMIT_LOGIN_PERIOD=1m
#RATE_LIMIT_REGISTER_CAPACITY=10
#RATE_LIMIT_REGISTER_PERIOD=1h
#RATE_LIMIT_MESSAGE_CAPACITY=30
#RATE_LIMIT_MESSAGE_PERIOD=1m
# false hides Swagger UI and /v3/api-docs
#SWAGGER_ENABLED=true
#LOG_LEVEL=INFO
#SHOW_SQL=false
#PORT=8080
#STORAGE_ROOT=uploads

# ---- docker compose only ----
# Host ports
#APP_PORT=8080
#POSTGRES_HOST_PORT=5434
